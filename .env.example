# --- Microsoft Entra ID / Defender for Endpoint ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CERT_PATH=./certs/shield-cert.pem
AZURE_CERT_THUMBPRINT=

# --- Datto RMM ---
# Find this in Setup > Users > (your user) > API URL, after generating keys
DATTO_API_URL=
DATTO_API_KEY=
DATTO_API_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Notifications ---
SENDER_MAILBOX=shield@yourcompany.com
IT_ESCALATION_EMAIL=it-team@yourcompany.com

# --- Timing (all optional, these are sensible defaults) ---
RECHECK_WINDOW_HOURS=48
REMINDER_MAX_COUNT=2
REMINDER_INTERVAL_HOURS=48
ESCALATION_AFTER_REMINDERS=2

# --- State store ---
STATE_DB_PATH=shield_state.db

# --- Pilot ---
PILOT_DEVICE_HOSTNAMES=
HOSTNAME_ALIASES=

# --- Auto-remediation ---
# UID of the SHIELD Auto-Remediation Runner component in Datto RMM
# Find it in Automation > Components > SHIELD Auto-Remediation Runner > UID field
SHIELD_REMEDIATION_COMPONENT_UID=
